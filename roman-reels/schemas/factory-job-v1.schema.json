{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fynotbefeg-rgb/sonvkrovatke/roman-reels/factory-job/1.0.0",
  "title": "Roman Factory Job 1.0.0 — candidate, not deployed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "reelId", "topicId", "hookNumber", "scriptVersion", "scriptHash", "hookText", "scriptText", "approvalStatus", "productionStatus"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "mode": {"enum": ["development", "production"]},
    "reelId": {"type": "string", "pattern": "^R-[a-z0-9][a-z0-9_-]*-h[123]$"},
    "topicId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "hookNumber": {"enum": [1, 2, 3]},
    "scriptVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "scriptHash": {"$ref": "#/$defs/hash"},
    "hookText": {"$ref": "#/$defs/text"},
    "scriptText": {"$ref": "#/$defs/text"},
    "approvalStatus": {"enum": ["pending_approval", "approved", "rejected"]},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approvedBy", "approvedAt", "scriptHash", "receiptReference"],
      "properties": {
        "approvedBy": {"$ref": "#/$defs/text"},
        "approvedAt": {"type": "string", "format": "date-time"},
        "scriptHash": {"$ref": "#/$defs/hash"},
        "receiptReference": {"$ref": "#/$defs/text"}
      }
    },
    "sourceVideo": {
      "type": "object", "additionalProperties": false,
      "required": ["localPath", "sha256", "duration", "width", "height", "fps"],
      "properties": {
        "localPath": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/hash"},
        "driveFileId": {"$ref": "#/$defs/text"},
        "origin": {"enum": ["repository_fixture", "manual_upload", "windows_browser"]},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "wordTimings": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/speechInterval"}
    },
    "speechSegments": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/speechInterval"}
    },
    "visualAssets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "localPath", "rightsReference"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "type": {"enum": ["image", "video", "audio", "font"]},
          "localPath": {"$ref": "#/$defs/text"},
          "rightsReference": {"$ref": "#/$defs/text"}
        }
      }
    },
    "montagePlan": {
      "type": "object", "additionalProperties": false, "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "start", "end", "wordStart", "wordEnd", "animation", "position", "layer", "transition", "respectSafeZone"],
            "properties": {
              "id": {"$ref": "#/$defs/text"},
              "type": {"enum": ["caption", "card", "keyword", "number", "zoom", "b_roll", "split_screen", "diagram", "interface"]},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "wordStart": {"type": "integer", "minimum": 0},
              "wordEnd": {"type": "integer", "minimum": 0},
              "assetId": {"$ref": "#/$defs/text"},
              "animation": {"enum": ["none", "fade", "slide", "pop"]},
              "position": {"enum": ["top", "center", "bottom", "full_frame"]},
              "layer": {"type": "integer", "minimum": 0},
              "transition": {"enum": ["none", "cut", "fade"]},
              "respectSafeZone": {"const": true}
            },
            "allOf": [{
              "if": {"properties": {"type": {"enum": ["b_roll", "interface"]}}},
              "then": {"required": ["assetId"]}
            }]
          }
        }
      }
    },
    "renderSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "fps", "codec", "audioCodec", "safeZone"],
      "properties": {
        "width": {"const": 1080}, "height": {"const": 1920},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "codec": {"const": "h264"}, "audioCodec": {"const": "aac"},
        "safeZone": {
          "type": "object", "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": {"type": "integer", "minimum": 0},
            "right": {"type": "integer", "minimum": 0},
            "bottom": {"type": "integer", "minimum": 0},
            "left": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "outputPath": {"$ref": "#/$defs/text"},
    "productionStatus": {"enum": ["queued", "waiting_for_manual_upload", "waiting_for_windows_worker", "source_ready", "transcribed", "montage_ready", "rendered", "qc_passed", "manual_attention", "failed"]},
    "errorDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"},
        "retryable": {"type": "boolean"}
      }
    },
    "qcReport": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "outputSha256", "checkedAt", "checks"],
      "properties": {
        "passed": {"const": true},
        "outputSha256": {"$ref": "#/$defs/hash"},
        "checkedAt": {"type": "string", "format": "date-time"},
        "checks": {
          "type": "object", "additionalProperties": false,
          "required": ["decode", "resolution", "audio", "duration", "plan", "assets", "subtitles"],
          "properties": {
            "decode": {"const": true}, "resolution": {"const": true},
            "audio": {"const": true}, "duration": {"const": true},
            "plan": {"const": true}, "assets": {"const": true}, "subtitles": {"const": true}
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"approvalStatus": {"const": "approved"}}}, "then": {"required": ["approval"]}, "else": {"not": {"required": ["approval"]}}},
    {"if": {"properties": {"mode": {"const": "production"}}}, "then": {"properties": {"approvalStatus": {"const": "approved"}}}},
    {"if": {"properties": {"productionStatus": {"enum": ["source_ready", "transcribed", "montage_ready", "rendered", "qc_passed"]}}}, "then": {"required": ["sourceVideo"]}},
    {"if": {"properties": {"productionStatus": {"enum": ["transcribed", "montage_ready", "rendered", "qc_passed"]}}}, "then": {"required": ["wordTimings", "speechSegments"]}},
    {"if": {"properties": {"productionStatus": {"enum": ["montage_ready", "rendered", "qc_passed"]}}}, "then": {"required": ["visualAssets", "montagePlan", "renderSettings"]}},
    {"if": {"properties": {"productionStatus": {"enum": ["rendered", "qc_passed"]}}}, "then": {"required": ["outputPath"]}},
    {"if": {"properties": {"productionStatus": {"const": "qc_passed"}}}, "then": {"required": ["qcReport"]}},
    {"if": {"properties": {"productionStatus": {"enum": ["failed", "manual_attention"]}}}, "then": {"required": ["errorDetails"]}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "speechInterval": {
      "type": "object", "additionalProperties": false, "required": ["text", "start", "end"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
